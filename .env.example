# Local: copy to .env. Docker: pass an external env file at runtime.
# No file is needed for the default self-contained demo.
# Set APP_MODE=mysql in the shell to opt in to reading this file.
APP_MODE=mysql
APP_ENV=development
# Development defaults to arbitrary-credential demo login. Production rejects true.
DEMO_LOGIN_ENABLED=true
DEMO_EMPLOYEE_NO=MFG001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Production: mounted AWS RDS CA bundle, not a private key.
DB_SSL_CA=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_HTTPS_ONLY=false
SESSION_MAX_AGE=28800
ALLOWED_HOSTS=localhost,127.0.0.1
LOGIN_LIMIT=20
LOGIN_WINDOW_SECONDS=900
ENABLE_LEGACY_POSTS=false
# Legacy public images, unused by the portal:
S3_BUCKET=
AWS_REGION=
CLOUDFRONT_DOMAIN=
# Optional one-time seed password. Prefer the interactive prompt.
SMARTFAB_DEMO_PASSWORD=
