# Local: copy to .env. Docker: pass an external env file at runtime.
APP_ENV=development
# sqlite for local development; production requires mysql.
DB_ENGINE=sqlite
SQLITE_PATH=.data/knowpilot.db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Production: mounted AWS RDS CA bundle, not a private key.
DB_SSL_CA=
# Required, 32+ characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Token lifetime in hours (8-12).
JWT_EXPIRE_HOURS=8
ALLOWED_HOSTS=localhost,127.0.0.1
LOGIN_LIMIT=20
LOGIN_WINDOW_SECONDS=900
# Optional answers for python -m scripts.seed_admin. Prefer the interactive prompt for the password.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_DEPARTMENT=ADM
ADMIN_PASSWORD=
# LLM (phase 2). Model specs are "provider:model-id"; providers: openai_compatible, anthropic, fake.
# Prices live in llm/models.yaml and are maintained by the project owner.
LLM_ROUTER_MODEL=
LLM_ANSWER_MODEL=
# Judge model for offline answer evaluation only (scripts.eval_retrieval --answer-model); should differ from the answer model.
LLM_JUDGE_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
LLM_TIMEOUT_SECONDS=30
# Cost guards: daily budget in USD (Taipei day), fallback price for unpriced models, concurrent calls.
LLM_DAILY_BUDGET_USD=2
LLM_FALLBACK_PRICE_PER_MTOK=10
LLM_MAX_CONCURRENCY=5
# Haiku 5.5 counts thinking tokens toward these limits: router output reached ~1,100, answers were cut off at 1,200.
LLM_ROUTER_MAX_TOKENS=1500
LLM_ANSWER_MAX_TOKENS=4000
LLM_JUDGE_MAX_TOKENS=2000
CHAT_MAX_INPUT_CHARS=500
# Chat (phase 4): per-user daily allowance in USD (router + answer, Taipei day; admins exempt),
# and the per-question cost used to estimate "about N questions left" until there is a week of data.
CHAT_USER_DAILY_BUDGET_USD=0.05
CHAT_DEFAULT_COST_PER_QUESTION_USD=0.0025
